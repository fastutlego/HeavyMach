+#[cfg(all(test, not(feature = "moleworld_compat")))]
+mod generic_guest_tests {
+    use super::*;
+    use crate::mem::MutPtr;
+
+    #[test]
+    fn moleworld_animation_addresses_preserve_other_guest_registers() {
+        let mut mem = Mem::new();
+        for pc in [0x0020_f540, 0x0020_f5d2] {
+            // Thumb MOVS r2, #7: neither r0 nor r1 may change.
+            mem.write(MutPtr::from_bits(pc), 0x2207_u16);
+            let mut cpu = InterpreterCpu::new(0);
+            cpu.cpsr = CPSR_USER_MODE | CPSR_THUMB;
+            cpu.regs[PC] = pc;
+            cpu.regs[0] = 0;
+            cpu.regs[1] = 0x900;
+            assert!(matches!(cpu.step_one(&mut mem), CpuState::Normal));
+            assert_eq!(cpu.regs[0], 0);
+            assert_eq!(cpu.regs[1], 0x900);
+            assert_eq!(cpu.regs[2], 7);
+            assert_eq!(cpu.regs[PC], pc + 2);
+        }
+    }
+
+    #[test]
+    fn moleworld_texture_address_executes_only_one_load() {
+        let mut mem = Mem::new();
+        let pc = 0x002e_7102;
+        // Thumb LDR.W r6, [r3], #4, identical to the fast-path trigger.
+        mem.write(MutPtr::from_bits(pc), 0xf853_u16);
+        mem.write(MutPtr::from_bits(pc + 2), 0x6b04_u16);
+        mem.write(MutPtr::from_bits(0x10000), 0x12345678_u32);
+        mem.write(MutPtr::from_bits(0x20000), 0xabcd_u16);
+        let mut cpu = InterpreterCpu::new(0);
+        cpu.cpsr = CPSR_USER_MODE | CPSR_THUMB;
+        cpu.regs[PC] = pc;
+        cpu.regs[3] = 0x10000;
+        cpu.regs[4] = 1;
+        cpu.regs[5] = 0x20000;
+        assert!(matches!(cpu.step_one(&mut mem), CpuState::Normal));
+        assert_eq!(cpu.regs[PC], pc + 4);
+        assert_eq!(cpu.regs[3], 0x10004);
+        assert_eq!(cpu.regs[4], 1);
+        assert_eq!(cpu.regs[5], 0x20000);
+        assert_eq!(cpu.regs[6], 0x12345678);
+        assert_eq!(mem.read(MutPtr::<u16>::from_bits(0x20000)), 0xabcd);
+    }
+}
